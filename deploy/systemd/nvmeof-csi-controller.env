# Settings for nvmeof-csi-controller.service and nvmeof-csi-upgrade.service.
# Install as /etc/default/nvmeof-csi-controller on the NVMe-oF target host.

# Binary downloaded by nvmeof-csi-upgrade.service. To pin a version, use
# https://github.com/timpa0130/nvmeof-csi/releases/download/v1.3.0/nvmeof-csi
NVMEOF_CSI_URL=https://github.com/timpa0130/nvmeof-csi/releases/latest/download/nvmeof-csi

# TCP address the external-provisioner dials (--csi-address=tcp://<this>).
NVMEOF_CSI_LISTEN=192.168.1.10:9090

# Address initiators (K8s nodes) connect to for NVMe-oF/TCP.
NVMEOF_CSI_TARGET_ADDR=192.168.1.10

# NVMe-oF/TCP port (trsvcid).
NVMEOF_CSI_PORT=4420

# ZFS pool that holds the zvols.
NVMEOF_CSI_POOL=nvme