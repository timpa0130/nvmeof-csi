# Settings for nvmeof-csi-controller.service.
# Install as /etc/default/nvmeof-csi-controller on the NVMe-oF target host.

# TCP address the external-provisioner dials (--csi-address=tcp://<this>).
NVMEOF_CSI_LISTEN=192.168.1.107:9090

# Address initiators (K8s nodes) connect to for NVMe-oF/TCP.
NVMEOF_CSI_TARGET_ADDR=192.168.1.107

# NVMe-oF/TCP port (trsvcid).
NVMEOF_CSI_PORT=4420

# ZFS pool that holds the zvols.
NVMEOF_CSI_POOL=nvme
